# Docker and mailboxd runtime configuration. Replace every placeholder before use.
PORT=8000
WORKERS=2
MAILBOXD_CONFIG=./config.yaml
MAILBOXD_STATE_PATH=/var/lib/mailboxd/state.db
MAILBOXD_TOKEN_MILA=your-token-here
MAILBOXD_TOKEN_OPS=your-operator-token-here
MAILBOXD_WEBHOOK_SECRET=your-webhook-secret-here
MAILBOX_CONTACT_PASSWORD=your-contact-password-here
MAILBOX_SUPPORT_PASSWORD=your-support-password-here
MAILBOX_PERSONAL_PASSWORD=your-app-password-here
# Client-side values used by the skill and bridge, not the server listener.
MAILBOX_URL=http://localhost:8000
MAILBOX_TOKEN=your-token-here
